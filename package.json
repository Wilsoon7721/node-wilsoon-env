{
  "name": "@wilsoon/env",
  "version": "0.3.0",
  "description": "End-to-end encrypted environment variables, synced through a storage provider of your choosing",
  "keywords": [
    "dotenv",
    "env",
    "secrets",
    "encryption",
    "cli",
    "s3"
  ],
  "bugs": {
    "url": "https://github.com/Wilsoon7721/node-wilsoon-env/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/node-wilsoon-env.git"
  },
  "homepage": "https://github.com/Wilsoon7721/node-wilsoon-env#readme",
  "license": "MIT",
  "author": "Wilson Oon",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "wilsoon-env": "cli/env.js"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "auth",
    "cli",
    "core",
    "providers",
    "schema",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "npm test",
    "lint": "wlint"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "peerDependencies": {
    "mongodb": ">=6"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wilsoon/eslint-config": "^0.4.2",
    "mongodb": "^7.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@wilsoon/eslint-config@*": true,
    "dprint@0.57.4": true
  }
}